# Federated server settings
FL_ROUNDS=3
FL_LOCAL_EPOCHS=1
FL_BATCH_SIZE=32
FL_LEARNING_RATE=0.000002
RUNS_DIR=./runs

# Each client has its own local manifest and image root.
# The manifest used inside the container must contain image paths beginning with /data/.
CLIENT_0_MANIFEST=/absolute/path/to/client_0_container.csv
CLIENT_0_DATA_ROOT=/absolute/path/to/client_0_images

CLIENT_1_MANIFEST=/absolute/path/to/client_1_container.csv
CLIENT_1_DATA_ROOT=/absolute/path/to/client_1_images

CLIENT_2_MANIFEST=/absolute/path/to/client_2_container.csv
CLIENT_2_DATA_ROOT=/absolute/path/to/client_2_images
