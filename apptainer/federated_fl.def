Bootstrap: docker
From: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

%files
    src /app/src
    containerized_fl /app/containerized_fl

%post
    pip install --no-cache-dir \
        flwr==1.19.0 \
        pandas==2.2.3 \
        Pillow==11.0.0

%environment
    export PYTHONPATH=/app:/app/src
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1

%runscript
    exec python "$@"
